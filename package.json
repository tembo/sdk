{
  "name": "@tembo-io/sdk",
  "version": "1.0.0-beta.0",
  "description": "Manage agents, sessions, repositories, and organization resources with the Tembo API.",
  "author": "Tembo",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/esm/index.js"
    },
    "./*.mjs": {
      "types": "./dist/esm/*.d.ts",
      "import": "./dist/esm/*.js",
      "default": "./dist/esm/*.js"
    },
    "./*.js": {
      "types": "./dist/esm/*.d.ts",
      "import": "./dist/esm/*.js",
      "require": "./dist/cjs/*.js",
      "default": "./dist/esm/*.js"
    },
    "./*": {
      "types": "./dist/esm/*.d.ts",
      "import": "./dist/esm/*.js",
      "require": "./dist/cjs/*.js",
      "default": "./dist/esm/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "api.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node scripts/finalize-build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.cjs.json --noEmit",
    "test": "npm run build && tsc -p tsconfig.consumer.json && node --test tests/*.test.mjs",
    "test:dev": "npm run build && node scripts/test-dev.mjs",
    "schema:fetch": "node scripts/fetch-schema.mjs",
    "prepublishOnly": "node -e \"console.error('Publishing is disabled until the Scalar migration is approved.'); process.exit(1)\""
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "6.0.3"
  },
  "license": "Apache-2.0",
  "private": true,
  "repository": "github:tembo/sdk",
  "engines": {
    "node": ">=24"
  }
}
